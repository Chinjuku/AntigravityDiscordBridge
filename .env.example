# Discord Bot Configuration (Required)
# ดึงค่าจาก Discord Developer Portal และ Discord Channel ของคุณ
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Local Bridge HTTP Server Port (Default: 4321)
PORT=4321

# ตำแหน่งโฟลเดอร์หลักสำหรับสแกนหาโปรเจกต์ทั้งหมดอัตโนมัติ (รองรับทั้ง macOS, Linux และ Windows)
# - macOS / Linux ตัวอย่าง: ~/Documents/project หรือ /Users/username/Documents/project
# - Windows ตัวอย่าง: C:\Users\Username\Documents\project หรือ ~/Documents/project
PROJECTS_DIR=~/Documents/project
